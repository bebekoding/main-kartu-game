{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "main-kartu-game",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.md"
    ],
    "rewrites": [
      { "source": "/", "destination": "/truf-multiplayer-v3.html" }
    ],
    "redirects": [
      { "source": "/truf-multiplayer-v2.html", "destination": "/", "type": 302 }
    ],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "cards/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(png|jpg|jpeg|webp|gif|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.mp3", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
