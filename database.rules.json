{
  "rules": {
    "rooms": {
      ".read": true,
      "$roomCode": {
        ".read": true,
        ".write": true,
        ".validate": "$roomCode.matches(/^[A-Z0-9]{4,6}$/)"
      }
    },
    "accounts": {
      ".read": true,
      "$username": {
        ".read": true,
        ".write": true
      }
    },
    "leaderboards": {
      ".read": true,
      "$game": {
        "$username": {
          ".read": true,
          ".write": true
        }
      }
    },
    "config": {
      "adminHash": {
        ".read": false,
        ".write": false
      }
    },
    "adminChallenge": {
      ".read": false,
      "$sessionId": {
        ".read": false,
        ".write": "newData.child('hash').isString() && newData.child('hash').val() === root.child('config/adminHash').val() && $sessionId.matches(/^[a-zA-Z0-9_-]{8,64}$/)",
        ".validate": "newData.hasChildren(['hash', 'ts'])"
      }
    }
  }
}
