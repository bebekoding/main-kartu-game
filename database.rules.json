{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      ".read": true,

      "$roomCode": {
        ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{4,6}$/) && ( (!data.exists() && newData.child('host').val() === auth.uid) || (!newData.exists() && (data.child('host').val() === auth.uid || root.child('adminSessions').child(auth.uid).exists())) )",

        "players": {
          "$playerUid": {
            ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{4,6}$/) && ( $playerUid === auth.uid || root.child('rooms').child($roomCode).child('host').val() === auth.uid || root.child('adminSessions').child(auth.uid).exists() || (!newData.exists() && (data.child('isBot').val() === true || data.child('disconnected').val() === true || data.child('disconnectedAt').exists())) )"
          }
        },

        "chat": {
          "$msgId": {
            ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{4,6}$/) && (!data.exists() || root.child('adminSessions').child(auth.uid).exists())"
          }
        },

        "voice": {
          "$voiceUid": {
            ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{4,6}$/) && ($voiceUid === auth.uid || root.child('adminSessions').child(auth.uid).exists())"
          }
        },

        "signals": {
          "$toUid": {
            ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{4,6}$/) && $toUid === auth.uid",
            "$signalId": {
              ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{4,6}$/) && (!data.exists() || $toUid === auth.uid)"
            }
          }
        },

        "$gameState": {
          ".write": "auth != null && $roomCode.matches(/^[A-Z0-9]{4,6}$/) && ( root.child('rooms').child($roomCode).child('players').child(auth.uid).exists() || root.child('adminSessions').child(auth.uid).exists() )"
        }
      }
    },

    "accounts": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ( (!data.exists() && newData.child('authUid').val() === auth.uid) || data.child('authUid').val() === auth.uid || root.child('adminSessions').child(auth.uid).exists() )",
        ".validate": "!newData.hasChild('password')",
        "authUid": {
          ".validate": "newData.val() === auth.uid || root.child('adminSessions').child(auth.uid).exists()"
        }
      }
    },

    "leaderboards": {
      ".read": true,
      "$game": {
        ".validate": "$game.matches(/^(truf|cangkul|remi|tebak)$/)",
        "$username": {
          ".write": "auth != null && ( root.child('adminSessions').child(auth.uid).exists() || root.child('rooms').child(newData.child('srcRoom').val()).child('host').val() === auth.uid )",
          ".validate": "!newData.exists() || ( newData.child('matches').val() === (data.exists() ? data.child('matches').val() : 0) + 1 && (newData.child('points').val() - (data.exists() ? data.child('points').val() : 0)) <= 11 && (newData.child('points').val() - (data.exists() ? data.child('points').val() : 0)) >= 0 )"
        }
      }
    },

    "config": {
      "adminHash": {
        ".read": false,
        ".write": false
      }
    },

    "adminSessions": {
      "$authUid": {
        ".read": "auth != null && auth.uid === $authUid",
        ".write": "auth != null && auth.uid === $authUid && ( !newData.exists() || newData.child('hash').val() === root.child('config/adminHash').val() )"
      }
    }
  }
}
